{
  "expo": {
    "name": "Atlas",
    "slug": "atlas",
    "scheme": "atlas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jversteeg.atlas",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jversteeg.atlas",
      "adaptiveIcon": {
        "backgroundColor": "#0B1226",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Bitter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Bitter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Bitter-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Bitter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Bitter-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Bitter-Regular.ttf",
              "./assets/fonts/Bitter-Medium.ttf",
              "./assets/fonts/Bitter-SemiBold.ttf",
              "./assets/fonts/Bitter-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1226"
        }
      ]
    ]
  }
}
