{
  "name": "atlas",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src App.tsx index.ts",
    "format": "prettier --write src App.tsx index.ts scripts eslint-rules eslint.config.mjs vitest.config.mts tailwind.config.ts .claude/hooks",
    "format:check": "prettier --check src App.tsx index.ts scripts eslint-rules eslint.config.mjs vitest.config.mts tailwind.config.ts .claude/hooks",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@supabase/supabase-js": "2.119.2",
    "date-fns": "4.4.0",
    "expo": "~58.1.0",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "1.81.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@10.32.1",
  "private": true
}
